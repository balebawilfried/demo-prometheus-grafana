groups:
  - name: server_linux
    rules:

    - alert: "Le serveur est Down"
      expr: up{job="node_exporter"} == 0
      for: 2m
      labels:
        severity: critical
        app_type: linux
        category: server
      annotations:
        summary: "Le serveur est down"
        description: "Le serveur est hors service depuis plus de 2 minutes."

    # Stockage de la mémoire libre  
    - record: Mémoire_libre
      expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100

    # Stockage de la mémoire consommée
    - record: "Mémoire utilisée"
      expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100
      
    - alert: "L'utilisation de la mémoire est entre 60% et 75%"
      expr: 60 < (100 - Mémoire_libre) < 75
      for: 2m
      labels:
        severity: warning
        app_type: linux
        category: memory
      annotations:
        summary: "L'utilisation de la mémoire est élevée"
        description: "La mémoire pour le noeud {{ $labels.instance }} a atteint {{ $value }}%"

    - alert: "L'utilisation de la mémoire est à plus de 75%"
      expr: (100 - Mémoire_libre) >= 75
      for: 2m
      labels:
        severity: critical
        app_type: linux
        category: memory
      annotations:
        summary: "L'utilisation de la mémoire est très élevée"
        description: "La mémoire pour le noeud {{ $labels.instance }} a atteint {{ $value }}%"

    - alert: "L'utilisation du CPU est très élevé"
      expr: 100 - (avg by(instance) (irate(node_cpu_seconds_total{mode="idle"}[1m])) * 100) > 80
      for: 2m
      labels:
        severity: critical
        app_type: linux
        category: cpu
      annotations:
        summary: "L'utilisation du CPU est très élevé"
        description: "La charge du CPU pour le noeud {{ $labels.instance }} a atteint {{ $value }}%"

    # Stockage du processeur (CPU) libre
    - record: Quantite_de_processus_libre
      expr: avg without(cpu)(rate (node_cpu_seconds_total{mode="idle"}[1m]))

    # Stockage du processeur (CPU) utilisé
    - record: Quantite_de_processeur_consommé
      expr: avg without(cpu, mode)(rate (node_cpu_seconds_total{mode!="idle"}[1m]))

    - alert: "L'utilisation du CPU_0 est très élevé"
      expr: 100 - (avg by(instance, cpu) (irate(node_cpu_seconds_total{mode="idle", cpu="0"}[1m])) * 100) > 80
      for: 2m
      labels:
        severity: critical
        app_type: linux
        category: cpu
      annotations:
        summary: "L'utilisation du CPU_0 est très élevé"
        description: "La charge du CPU_0 pour le noeud {{ $labels.instance }} a atteint {{ $value }}%"

    - alert: "L'utilisation du CPU_1 est très élevé"
      expr: 100 - (avg by(instance, cpu) (irate(node_cpu_seconds_total{mode="idle", cpu="1"}[1m])) * 100) > 80
      for: 2m
      labels:
        severity: critical
        app_type: linux
        category: cpu
      annotations:
        summary: "L'utilisation du CPU_1 est très élevé"
        description: "La charge du CPU_1 pour le noeud {{ $labels.instance }} a atteint {{ $value }}%"

    - alert: "L'espace disque libre est de moins de 30 %"
      expr: (sum by (instance) (node_filesystem_free_bytes) / sum by (instance) (node_filesystem_size_bytes)) * 100 < 30
      for: 2m
      labels:
        severity: warning
        app_type: linux
        category: disk
      annotations:
        summary: "L'espace disque disponible sur le nœud est presque épuisé."
        description: "Le disque du nœud est presque plein (< 30% restant)\n  L'espace disque libre actuel est {{ $value }}"

